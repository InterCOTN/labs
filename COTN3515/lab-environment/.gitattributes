# Los scripts y configuraciones se ejecutan dentro de contenedores Linux: siempre LF.
*.sh   text eol=lf
*.py   text eol=lf
*.nft  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Claves y certificados de prueba: siempre LF (con CRLF, sshd rechaza la clave de host: "invalid format")
tls/* text eol=lf
